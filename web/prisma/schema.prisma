generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// Running numbers for documents, one row per prefix and year (e.g. "INV-2026").
model Counter {
  key   String @id
  value Int    @default(0)
}

model Item {
  id            Int                 @id @default(autoincrement())
  code          String              @unique
  name          String
  casNumber     String?
  unit          String              @default("kg")
  hazardClass   String?
  notes         String?
  // The item code registered with the Egyptian Tax Authority, e.g. EG-100324932-LIN001 (EGS) or a GS1 barcode.
  etaItemCode   String?
  etaItemType   String              @default("EGS")
  active        Boolean             @default(true)
  // Warn when stock on hand falls to this or below. Empty means no alert.
  minQty        Decimal?            @db.Decimal(14, 3)
  createdAt     DateTime            @default(now())
  lots          Lot[]
  shipmentLines ShipmentLine[]
  invoiceLines  InvoiceLine[]
  quoteLines    QuoteLine[]
  orderLines    PurchaseOrderLine[]
  rfqLines      RfqLine[]
}

model Supplier {
  id                 Int               @id @default(autoincrement())
  name               String            @unique
  country            String?
  currency           String            @default("USD")
  email              String?
  phone              String?
  notes              String?
  // Days after the order date that a shipment's goods are due to be paid, unless the shipment says otherwise.
  paymentTermsDays   Int               @default(0)
  // What was owed to this supplier before using this system, in the supplier's currency.
  openingBalance     Decimal           @default(0) @db.Decimal(14, 2)
  openingBalanceDate DateTime?         @db.Date
  openingFxRate      Decimal?          @db.Decimal(14, 6) // EGP for 1 unit of the opening balance's currency
  createdAt          DateTime          @default(now())
  shipments          Shipment[]
  payments           SupplierPayment[]
  purchaseOrders     PurchaseOrder[]
  cheques            Cheque[]
  rfqs               RfqSupplier[]
  rfqQuotes          RfqQuote[]
}

model Customer {
  id                 Int               @id @default(autoincrement())
  name               String            @unique
  taxId              String?
  phone              String?
  email              String?
  address            String?
  // Address parts the Egyptian Tax Authority needs on an e-invoice.
  etaType            String            @default("B") // B business, P person, F foreign
  country            String            @default("EG")
  governate          String?
  city               String?
  street             String?
  buildingNo         String?
  notes              String?
  // Days after the invoice date that payment is due.
  paymentTermsDays   Int               @default(30)
  // What this customer owed before using this system, in EGP. Negative if they had credit.
  openingBalance     Decimal           @default(0) @db.Decimal(14, 2)
  openingBalanceDate DateTime?         @db.Date
  // Most this customer may owe at once, in EGP. Empty means no limit.
  creditLimit        Decimal?          @db.Decimal(14, 2)
  createdAt          DateTime          @default(now())
  invoices           Invoice[]
  payments           CustomerPayment[]
  quotes             Quote[]
  creditNotes        CreditNote[]
  cheques            Cheque[]
}

enum ShipmentStatus {
  ORDERED
  IN_TRANSIT
  AT_CUSTOMS
  RECEIVED
}

enum AllocationMethod {
  VALUE
  QUANTITY
}

model Shipment {
  id                Int               @id @default(autoincrement())
  ref               String            @unique
  supplierId        Int
  supplier          Supplier          @relation(fields: [supplierId], references: [id])
  supplierInvoiceNo String?
  currency          String
  fxRate            Decimal           @db.Decimal(14, 6)
  allocation        AllocationMethod  @default(VALUE)
  orderDate         DateTime          @db.Date
  etd               DateTime?         @db.Date
  eta               DateTime?         @db.Date
  arrivalDate       DateTime?         @db.Date
  // When the supplier must be paid; empty means the order date plus the supplier's payment terms.
  dueDate           DateTime?         @db.Date
  status            ShipmentStatus    @default(ORDERED)
  notes             String?
  // The purchase order this shipment delivers, when there is one.
  purchaseOrderId   Int?
  purchaseOrder     PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  createdAt         DateTime          @default(now())
  lines             ShipmentLine[]
  charges           ShipmentCharge[]
  payments          SupplierPayment[]
  cheques           Cheque[]
}

model ShipmentLine {
  id              Int                @id @default(autoincrement())
  shipmentId      Int
  shipment        Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  itemId          Int
  item            Item               @relation(fields: [itemId], references: [id])
  qty             Decimal            @db.Decimal(14, 3)
  unitPrice       Decimal            @db.Decimal(14, 4)
  supplierBatchNo String?
  expiryDate      DateTime?          @db.Date
  lot             Lot?
  orderLineId     Int?
  orderLine       PurchaseOrderLine? @relation(fields: [orderLineId], references: [id])
}

model ShipmentCharge {
  id          Int           @id @default(autoincrement())
  shipmentId  Int
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  kind        String
  description String?
  amountEgp   Decimal       @db.Decimal(14, 2)
  // When and from which account it was paid, so bank balances include it.
  date        DateTime?     @db.Date
  accountId   Int?
  account     MoneyAccount? @relation(fields: [accountId], references: [id])
}

model Lot {
  id              Int           @id @default(autoincrement())
  lotNo           String        @unique
  itemId          Int
  item            Item          @relation(fields: [itemId], references: [id])
  shipmentLineId  Int?          @unique
  shipmentLine    ShipmentLine? @relation(fields: [shipmentLineId], references: [id])
  receivedDate    DateTime      @db.Date
  qtyReceived     Decimal       @db.Decimal(14, 3)
  qtyOnHand       Decimal       @db.Decimal(14, 3)
  unitCostEgp     Decimal       @db.Decimal(14, 4)
  expiryDate      DateTime?     @db.Date
  supplierBatchNo String?
  createdAt       DateTime      @default(now())
  moves           StockMove[]
  invoiceLines    InvoiceLine[]
}

enum MoveKind {
  OPENING
  RECEIPT
  SALE
  ADJUSTMENT
  RETURN
}

// Every change to a lot's quantity. qty is negative for stock going out.
model StockMove {
  id            Int             @id @default(autoincrement())
  lotId         Int
  lot           Lot             @relation(fields: [lotId], references: [id])
  date          DateTime        @db.Date
  kind          MoveKind
  qty           Decimal         @db.Decimal(14, 3)
  unitCostEgp   Decimal         @db.Decimal(14, 4)
  invoiceLineId Int?
  invoiceLine   InvoiceLine?    @relation(fields: [invoiceLineId], references: [id])
  // Stock a customer sent back, on a credit note.
  creditLineId  Int?
  creditLine    CreditNoteLine? @relation(fields: [creditLineId], references: [id])
  note          String?
  createdAt     DateTime        @default(now())

  @@index([lotId])
  @@index([date])
}

enum InvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Invoice {
  id                Int               @id @default(autoincrement())
  number            String            @unique
  customerId        Int
  customer          Customer          @relation(fields: [customerId], references: [id])
  date              DateTime          @db.Date
  // Set when posted, from the customer's payment terms.
  dueDate           DateTime?         @db.Date
  // Egyptian Tax Authority e-invoice: what happened when it was sent.
  etaStatus         EtaStatus         @default(NOT_SENT)
  etaUuid           String?           @unique
  etaLongId         String?
  etaSubmissionUuid String?
  etaError          String?
  etaSentAt         DateTime?
  status            InvoiceStatus     @default(DRAFT)
  vatRate           Decimal           @default(14) @db.Decimal(5, 2)
  notes             String?
  createdAt         DateTime          @default(now())
  postedAt          DateTime?
  lines             InvoiceLine[]
  payments          CustomerPayment[]
  quote             Quote?
  creditNotes       CreditNote[]
  cheques           Cheque[]

  @@index([date])
}

model InvoiceLine {
  id        Int              @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Item             @relation(fields: [itemId], references: [id])
  // A specific lot the customer asked for; left empty, stock is taken earliest-expiry first.
  lotId     Int?
  lot       Lot?             @relation(fields: [lotId], references: [id])
  qty       Decimal          @db.Decimal(14, 3)
  unitPrice Decimal          @db.Decimal(14, 4)
  moves     StockMove[]
  credited  CreditNoteLine[]
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
}

// Money received from a customer. It pays the invoice it names first, then their oldest unpaid invoices.
model CustomerPayment {
  id         Int           @id @default(autoincrement())
  number     String        @unique
  customerId Int
  customer   Customer      @relation(fields: [customerId], references: [id])
  invoiceId  Int?
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id])
  accountId  Int?
  account    MoneyAccount? @relation(fields: [accountId], references: [id])
  date       DateTime      @db.Date
  amount     Decimal       @db.Decimal(14, 2)
  method     PaymentMethod
  reference  String?
  notes      String?
  createdAt  DateTime      @default(now())

  @@index([customerId])
}

// Money paid to a supplier, in the currency paid. It pays the shipment it names first, then their oldest unpaid shipments.
model SupplierPayment {
  id         Int           @id @default(autoincrement())
  number     String        @unique
  supplierId Int
  supplier   Supplier      @relation(fields: [supplierId], references: [id])
  shipmentId Int?
  shipment   Shipment?     @relation(fields: [shipmentId], references: [id])
  accountId  Int?
  account    MoneyAccount? @relation(fields: [accountId], references: [id])
  date       DateTime      @db.Date
  currency   String
  amount     Decimal       @db.Decimal(14, 2)
  // EGP for one unit of the currency on the day paid.
  fxRate     Decimal       @db.Decimal(14, 6)
  method     PaymentMethod
  reference  String?
  notes      String?
  createdAt  DateTime      @default(now())

  @@index([supplierId])
}

enum AccountKind {
  BANK
  CASH
}

// A bank account or cash box. Its balance is worked out from everything paid in and out of it.
model MoneyAccount {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  kind             AccountKind       @default(BANK)
  currency         String            @default("EGP")
  openingBalance   Decimal           @default(0) @db.Decimal(14, 2)
  openingDate      DateTime?         @db.Date
  openingFxRate    Decimal?          @db.Decimal(14, 6) // EGP for 1 unit, for a foreign currency account
  active           Boolean           @default(true)
  notes            String?
  createdAt        DateTime          @default(now())
  customerPayments CustomerPayment[]
  supplierPayments SupplierPayment[]
  charges          ShipmentCharge[]
  expenses         Expense[]
  transfersOut     Transfer[]        @relation("TransferFrom")
  transfersIn      Transfer[]        @relation("TransferTo")
  journalLines     JournalLine[]
  cheques          Cheque[]
}

// Running costs of the business: rent, salaries, transport. Import costs belong on the shipment instead.
model Expense {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  date        DateTime      @db.Date
  category    String
  description String?
  payee       String?
  // Before VAT, in EGP.
  amount      Decimal       @db.Decimal(14, 2)
  vat         Decimal       @default(0) @db.Decimal(14, 2)
  accountId   Int?
  account     MoneyAccount? @relation(fields: [accountId], references: [id])
  reference   String?
  createdAt   DateTime      @default(now())

  @@index([date])
}

// Money moved between two of VIOCHEM's own accounts, such as a cash deposit or buying dollars.
model Transfer {
  id            Int          @id @default(autoincrement())
  date          DateTime     @db.Date
  fromAccountId Int
  fromAccount   MoneyAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   Int
  toAccount     MoneyAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  // Taken out, in the first account's currency.
  amount        Decimal      @db.Decimal(14, 2)
  // Put in, in the second account's currency. The same as amount when the currencies match.
  toAmount      Decimal      @db.Decimal(14, 2)
  note          String?
  createdAt     DateTime     @default(now())
}

enum EtaStatus {
  NOT_SENT
  SUBMITTED // accepted for checking; ETA is still validating it
  VALID
  INVALID
  REJECTED // refused on submission; fix and send again
  CANCELLED
}

// VIOCHEM's own details as registered with the Egyptian Tax Authority. One row.
model EtaSettings {
  id              Int      @id @default(1)
  taxId           String   @default("")
  name            String   @default("VIOCHEM")
  activityCode    String   @default("")
  branchId        String   @default("0")
  governate       String   @default("")
  city            String   @default("")
  street          String   @default("")
  buildingNo      String   @default("")
  postalCode      String?
  // 0.9 needs no signature and is only for pre-production testing; 1.0 must be signed.
  documentVersion String   @default("1.0")
  updatedAt       DateTime @updatedAt
}

/**
 * Where an account appears in the balance sheet or income statement.
 */
enum LedgerSection {
  CURRENT_ASSETS
  FIXED_ASSETS
  CURRENT_LIABILITIES
  LONG_TERM_LIABILITIES
  EQUITY
  REVENUE
  COST_OF_SALES
  SELLING
  ADMIN
  FINANCE
  OTHER_INCOME
  INCOME_TAX
}

/**
 * The chart of accounts. Bank and cash accounts are added from MoneyAccount, one each.
 */
model LedgerAccount {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  name      String
  section   LedgerSection
  // Kept by the system from documents, so it can't take manual entries or be removed.
  system    Boolean       @default(false)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  lines     JournalLine[]
}

/**
 * A manual journal entry, for what no document records: capital, loans, depreciation, VAT settlement.
 */
model JournalEntry {
  id        Int           @id @default(autoincrement())
  number    String        @unique
  date      DateTime      @db.Date
  memo      String
  createdBy String?
  createdAt DateTime      @default(now())
  lines     JournalLine[]
}

model JournalLine {
  id              Int            @id @default(autoincrement())
  entryId         Int
  entry           JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  ledgerAccountId Int?
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  moneyAccountId  Int?
  moneyAccount    MoneyAccount?  @relation(fields: [moneyAccountId], references: [id])
  debit           Decimal        @default(0) @db.Decimal(14, 2)
  credit          Decimal        @default(0) @db.Decimal(14, 2)
  memo            String?

  @@index([entryId])
}

enum QuoteStatus {
  OPEN
  ACCEPTED // turned into an invoice
  DECLINED
}

// A price offer to a customer. Accepting it makes a draft invoice with the same lines.
model Quote {
  id         Int         @id @default(autoincrement())
  number     String      @unique
  customerId Int
  customer   Customer    @relation(fields: [customerId], references: [id])
  date       DateTime    @db.Date
  validUntil DateTime?   @db.Date
  status     QuoteStatus @default(OPEN)
  vatRate    Decimal     @default(14) @db.Decimal(5, 2)
  notes      String?
  invoiceId  Int?        @unique
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id])
  createdAt  DateTime    @default(now())
  lines      QuoteLine[]

  @@index([date])
}

model QuoteLine {
  id        Int     @id @default(autoincrement())
  quoteId   Int
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Item    @relation(fields: [itemId], references: [id])
  qty       Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(14, 4)
}

enum CreditNoteStatus {
  DRAFT
  POSTED
  CANCELLED
}

// Money given back on a posted invoice: goods returned, or a price reduced. Sent to ETA as a credit note.
model CreditNote {
  id                Int              @id @default(autoincrement())
  number            String           @unique
  invoiceId         Int
  invoice           Invoice          @relation(fields: [invoiceId], references: [id])
  customerId        Int
  customer          Customer         @relation(fields: [customerId], references: [id])
  date              DateTime         @db.Date
  reason            String
  status            CreditNoteStatus @default(DRAFT)
  // The invoice's VAT rate, so the credit reverses exactly what was charged.
  vatRate           Decimal          @db.Decimal(5, 2)
  etaStatus         EtaStatus        @default(NOT_SENT)
  etaUuid           String?          @unique
  etaLongId         String?
  etaSubmissionUuid String?
  etaError          String?
  etaSentAt         DateTime?
  createdAt         DateTime         @default(now())
  postedAt          DateTime?
  lines             CreditNoteLine[]

  @@index([invoiceId])
  @@index([date])
}

model CreditNoteLine {
  id            Int         @id @default(autoincrement())
  creditNoteId  Int
  creditNote    CreditNote  @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceLineId Int
  invoiceLine   InvoiceLine @relation(fields: [invoiceLineId], references: [id])
  qty           Decimal     @db.Decimal(14, 3)
  // Before VAT, per unit.
  unitPrice     Decimal     @db.Decimal(14, 4)
  // The goods came back and go into stock again; otherwise only the price is credited.
  restock       Boolean     @default(true)
  moves         StockMove[]
}

enum PurchaseOrderStatus {
  OPEN
  CLOSED // everything shipped, or closed by hand
  CANCELLED
}

// What VIOCHEM ordered from a supplier. Shipments are made from it as the goods are sent.
model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  number       String              @unique
  supplierId   Int
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  date         DateTime            @db.Date
  expectedDate DateTime?           @db.Date
  currency     String
  status       PurchaseOrderStatus @default(OPEN)
  notes        String?
  createdAt    DateTime            @default(now())
  lines        PurchaseOrderLine[]
  shipments    Shipment[]
  rfqQuotes    RfqQuote[]
}

model PurchaseOrderLine {
  id            Int            @id @default(autoincrement())
  orderId       Int
  order         PurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId        Int
  item          Item           @relation(fields: [itemId], references: [id])
  qty           Decimal        @db.Decimal(14, 3)
  unitPrice     Decimal        @db.Decimal(14, 4)
  shipmentLines ShipmentLine[]
}

enum ChequeDirection {
  RECEIVED // from a customer
  ISSUED // to a supplier
}

enum ChequeStatus {
  PENDING // received and in hand, or written and not yet cashed
  DEPOSITED // received cheque handed to the bank
  CLEARED // the money moved
  BOUNCED // refused by the bank, or returned
}

/**
 * A cheque, usually post-dated. A received cheque settles the customer's balance when received and
 * waits in 1220 until it clears into the bank; if it bounces the customer owes the amount again.
 * An issued cheque settles the supplier and waits in 2120 until it is cashed. Amounts are in EGP.
 */
model Cheque {
  id          Int             @id @default(autoincrement())
  number      String          @unique
  direction   ChequeDirection
  chequeNo    String
  bank        String?
  customerId  Int?
  customer    Customer?       @relation(fields: [customerId], references: [id])
  supplierId  Int?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  invoiceId   Int?
  invoice     Invoice?        @relation(fields: [invoiceId], references: [id])
  shipmentId  Int?
  shipment    Shipment?       @relation(fields: [shipmentId], references: [id])
  // When it was received or written.
  date        DateTime        @db.Date
  // The date on the cheque: it can't be cashed before.
  dueDate     DateTime        @db.Date
  amount      Decimal         @db.Decimal(14, 2)
  status      ChequeStatus    @default(PENDING)
  // Received: the account it was deposited into. Issued: the account it is drawn on.
  accountId   Int?
  account     MoneyAccount?   @relation(fields: [accountId], references: [id])
  depositedOn DateTime?       @db.Date
  clearedOn   DateTime?       @db.Date
  bouncedOn   DateTime?       @db.Date
  notes       String?
  createdAt   DateTime        @default(now())

  @@index([dueDate])
  @@index([customerId])
  @@index([supplierId])
}

enum RfqStatus {
  OPEN // collecting prices from suppliers
  ORDERED // purchase orders made from the chosen prices
  CANCELLED
}

/**
 * A request for quotation: the materials needed, sent to several suppliers as an Excel sheet.
 * Their prices come back on the same sheet and are compared at landed cost in EGP.
 */
model Rfq {
  id        Int           @id @default(autoincrement())
  number    String        @unique
  date      DateTime      @db.Date
  // When suppliers should reply by, and when the goods are needed in Egypt.
  replyBy   DateTime?     @db.Date
  neededBy  DateTime?     @db.Date
  status    RfqStatus     @default(OPEN)
  notes     String?
  createdAt DateTime      @default(now())
  lines     RfqLine[]
  suppliers RfqSupplier[]
  quotes    RfqQuote[]
  rates     RfqRate[]
}

model RfqLine {
  id     Int        @id @default(autoincrement())
  rfqId  Int
  rfq    Rfq        @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  itemId Int
  item   Item       @relation(fields: [itemId], references: [id])
  qty    Decimal    @db.Decimal(14, 3)
  notes  String?
  quotes RfqQuote[]
}

/**
 * A supplier asked to quote.
 */
model RfqSupplier {
  id         Int       @id @default(autoincrement())
  rfqId      Int
  rfq        Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId Int
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  // When the sheet was downloaded for them, and when their reply was loaded.
  sentAt     DateTime?
  repliedAt  DateTime?

  @@unique([rfqId, supplierId])
}

/**
 * One supplier's price for one line.
 */
model RfqQuote {
  id               Int            @id @default(autoincrement())
  rfqId            Int
  rfq              Rfq            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  rfqLineId        Int
  line             RfqLine        @relation(fields: [rfqLineId], references: [id], onDelete: Cascade)
  supplierId       Int
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  currency         String
  unitPrice        Decimal        @db.Decimal(14, 4)
  // The smallest quantity they will sell.
  moq              Decimal?       @db.Decimal(14, 3)
  leadTimeDays     Int?
  paymentTermsDays Int?
  validUntil       DateTime?      @db.Date
  incoterm         String?
  notes            String?
  // How much to buy at this price, once chosen.
  awardQty         Decimal?       @db.Decimal(14, 3)
  purchaseOrderId  Int?
  purchaseOrder    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@unique([rfqLineId, supplierId])
}

/**
 * EGP for 1 unit of each currency quoted, used to compare prices.
 */
model RfqRate {
  id       Int     @id @default(autoincrement())
  rfqId    Int
  rfq      Rfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  currency String
  rate     Decimal @db.Decimal(14, 6)

  @@unique([rfqId, currency])
}
