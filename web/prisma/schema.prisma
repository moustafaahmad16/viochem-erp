generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// Running numbers for documents, one row per prefix and year (e.g. "INV-2026").
model Counter {
  key   String @id
  value Int    @default(0)
}

model Item {
  id            Int            @id @default(autoincrement())
  code          String         @unique
  name          String
  casNumber     String?
  unit          String         @default("kg")
  hazardClass   String?
  notes         String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  lots          Lot[]
  shipmentLines ShipmentLine[]
  invoiceLines  InvoiceLine[]
}

model Supplier {
  id                 Int               @id @default(autoincrement())
  name               String            @unique
  country            String?
  currency           String            @default("USD")
  email              String?
  phone              String?
  notes              String?
  // Days after the order date that a shipment's goods are due to be paid, unless the shipment says otherwise.
  paymentTermsDays   Int               @default(0)
  // What was owed to this supplier before using this system, in the supplier's currency.
  openingBalance     Decimal           @default(0) @db.Decimal(14, 2)
  openingBalanceDate DateTime?         @db.Date
  createdAt          DateTime          @default(now())
  shipments          Shipment[]
  payments           SupplierPayment[]
}

model Customer {
  id                 Int               @id @default(autoincrement())
  name               String            @unique
  taxId              String?
  phone              String?
  email              String?
  address            String?
  notes              String?
  // Days after the invoice date that payment is due.
  paymentTermsDays   Int               @default(30)
  // What this customer owed before using this system, in EGP. Negative if they had credit.
  openingBalance     Decimal           @default(0) @db.Decimal(14, 2)
  openingBalanceDate DateTime?         @db.Date
  createdAt          DateTime          @default(now())
  invoices           Invoice[]
  payments           CustomerPayment[]
}

enum ShipmentStatus {
  ORDERED
  IN_TRANSIT
  AT_CUSTOMS
  RECEIVED
}

enum AllocationMethod {
  VALUE
  QUANTITY
}

model Shipment {
  id                Int               @id @default(autoincrement())
  ref               String            @unique
  supplierId        Int
  supplier          Supplier          @relation(fields: [supplierId], references: [id])
  supplierInvoiceNo String?
  currency          String
  fxRate            Decimal           @db.Decimal(14, 6)
  allocation        AllocationMethod  @default(VALUE)
  orderDate         DateTime          @db.Date
  etd               DateTime?         @db.Date
  eta               DateTime?         @db.Date
  arrivalDate       DateTime?         @db.Date
  // When the supplier must be paid; empty means the order date plus the supplier's payment terms.
  dueDate           DateTime?         @db.Date
  status            ShipmentStatus    @default(ORDERED)
  notes             String?
  createdAt         DateTime          @default(now())
  lines             ShipmentLine[]
  charges           ShipmentCharge[]
  payments          SupplierPayment[]
}

model ShipmentLine {
  id              Int       @id @default(autoincrement())
  shipmentId      Int
  shipment        Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  itemId          Int
  item            Item      @relation(fields: [itemId], references: [id])
  qty             Decimal   @db.Decimal(14, 3)
  unitPrice       Decimal   @db.Decimal(14, 4)
  supplierBatchNo String?
  expiryDate      DateTime? @db.Date
  lot             Lot?
}

model ShipmentCharge {
  id          Int           @id @default(autoincrement())
  shipmentId  Int
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  kind        String
  description String?
  amountEgp   Decimal       @db.Decimal(14, 2)
  // When and from which account it was paid, so bank balances include it.
  date        DateTime?     @db.Date
  accountId   Int?
  account     MoneyAccount? @relation(fields: [accountId], references: [id])
}

model Lot {
  id              Int           @id @default(autoincrement())
  lotNo           String        @unique
  itemId          Int
  item            Item          @relation(fields: [itemId], references: [id])
  shipmentLineId  Int?          @unique
  shipmentLine    ShipmentLine? @relation(fields: [shipmentLineId], references: [id])
  receivedDate    DateTime      @db.Date
  qtyReceived     Decimal       @db.Decimal(14, 3)
  qtyOnHand       Decimal       @db.Decimal(14, 3)
  unitCostEgp     Decimal       @db.Decimal(14, 4)
  expiryDate      DateTime?     @db.Date
  supplierBatchNo String?
  createdAt       DateTime      @default(now())
  moves           StockMove[]
  invoiceLines    InvoiceLine[]
}

enum MoveKind {
  OPENING
  RECEIPT
  SALE
  ADJUSTMENT
}

// Every change to a lot's quantity. qty is negative for stock going out.
model StockMove {
  id            Int          @id @default(autoincrement())
  lotId         Int
  lot           Lot          @relation(fields: [lotId], references: [id])
  date          DateTime     @db.Date
  kind          MoveKind
  qty           Decimal      @db.Decimal(14, 3)
  unitCostEgp   Decimal      @db.Decimal(14, 4)
  invoiceLineId Int?
  invoiceLine   InvoiceLine? @relation(fields: [invoiceLineId], references: [id])
  note          String?
  createdAt     DateTime     @default(now())

  @@index([lotId])
  @@index([date])
}

enum InvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Invoice {
  id         Int               @id @default(autoincrement())
  number     String            @unique
  customerId Int
  customer   Customer          @relation(fields: [customerId], references: [id])
  date       DateTime          @db.Date
  // Set when posted, from the customer's payment terms.
  dueDate    DateTime?         @db.Date
  status     InvoiceStatus     @default(DRAFT)
  vatRate    Decimal           @default(14) @db.Decimal(5, 2)
  notes      String?
  createdAt  DateTime          @default(now())
  postedAt   DateTime?
  lines      InvoiceLine[]
  payments   CustomerPayment[]

  @@index([date])
}

model InvoiceLine {
  id        Int         @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Item        @relation(fields: [itemId], references: [id])
  // A specific lot the customer asked for; left empty, stock is taken earliest-expiry first.
  lotId     Int?
  lot       Lot?        @relation(fields: [lotId], references: [id])
  qty       Decimal     @db.Decimal(14, 3)
  unitPrice Decimal     @db.Decimal(14, 4)
  moves     StockMove[]
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
}

// Money received from a customer. It pays the invoice it names first, then their oldest unpaid invoices.
model CustomerPayment {
  id         Int           @id @default(autoincrement())
  number     String        @unique
  customerId Int
  customer   Customer      @relation(fields: [customerId], references: [id])
  invoiceId  Int?
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id])
  accountId  Int?
  account    MoneyAccount? @relation(fields: [accountId], references: [id])
  date       DateTime      @db.Date
  amount     Decimal       @db.Decimal(14, 2)
  method     PaymentMethod
  reference  String?
  notes      String?
  createdAt  DateTime      @default(now())

  @@index([customerId])
}

// Money paid to a supplier, in the currency paid. It pays the shipment it names first, then their oldest unpaid shipments.
model SupplierPayment {
  id         Int           @id @default(autoincrement())
  number     String        @unique
  supplierId Int
  supplier   Supplier      @relation(fields: [supplierId], references: [id])
  shipmentId Int?
  shipment   Shipment?     @relation(fields: [shipmentId], references: [id])
  accountId  Int?
  account    MoneyAccount? @relation(fields: [accountId], references: [id])
  date       DateTime      @db.Date
  currency   String
  amount     Decimal       @db.Decimal(14, 2)
  // EGP for one unit of the currency on the day paid.
  fxRate     Decimal       @db.Decimal(14, 6)
  method     PaymentMethod
  reference  String?
  notes      String?
  createdAt  DateTime      @default(now())

  @@index([supplierId])
}

enum AccountKind {
  BANK
  CASH
}

// A bank account or cash box. Its balance is worked out from everything paid in and out of it.
model MoneyAccount {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  kind             AccountKind       @default(BANK)
  currency         String            @default("EGP")
  openingBalance   Decimal           @default(0) @db.Decimal(14, 2)
  openingDate      DateTime?         @db.Date
  active           Boolean           @default(true)
  notes            String?
  createdAt        DateTime          @default(now())
  customerPayments CustomerPayment[]
  supplierPayments SupplierPayment[]
  charges          ShipmentCharge[]
  expenses         Expense[]
  transfersOut     Transfer[]        @relation("TransferFrom")
  transfersIn      Transfer[]        @relation("TransferTo")
}

// Running costs of the business: rent, salaries, transport. Import costs belong on the shipment instead.
model Expense {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  date        DateTime      @db.Date
  category    String
  description String?
  payee       String?
  // Before VAT, in EGP.
  amount      Decimal       @db.Decimal(14, 2)
  vat         Decimal       @default(0) @db.Decimal(14, 2)
  accountId   Int?
  account     MoneyAccount? @relation(fields: [accountId], references: [id])
  reference   String?
  createdAt   DateTime      @default(now())

  @@index([date])
}

// Money moved between two of VIOCHEM's own accounts, such as a cash deposit or buying dollars.
model Transfer {
  id            Int          @id @default(autoincrement())
  date          DateTime     @db.Date
  fromAccountId Int
  fromAccount   MoneyAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   Int
  toAccount     MoneyAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  // Taken out, in the first account's currency.
  amount        Decimal      @db.Decimal(14, 2)
  // Put in, in the second account's currency. The same as amount when the currencies match.
  toAmount      Decimal      @db.Decimal(14, 2)
  note          String?
  createdAt     DateTime     @default(now())
}
