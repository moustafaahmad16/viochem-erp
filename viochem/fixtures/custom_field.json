  "fieldname": "cas_number",
  "label": "CAS Number",
  "fieldtype": "Data",
  "insert_after": "chemical_section",
  "module": "Viochem",
  "in_standard_filter": 1,
  "in_global_search": 1,
  "description": "Format 1234-56-7. The check digit is verified on save."
 },
 {
  "doctype": "Custom Field",
  "name": "Item-chemical_name",
  "dt": "Item",
