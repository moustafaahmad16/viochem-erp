  "insert_after": "chemical_col_break",
  "module": "Viochem",
  "options": "\nNot Hazardous\n3 - Flammable Liquid\n4.1 - Flammable Solid\n6.1 - Toxic\n8 - Corrosive\n9 - Miscellaneous"
 },
 {
  "doctype": "Custom Field",
